{
  "name": "@sandbar-ui/tokens",
  "version": "0.0.0",
  "description": "Sandbar UI design tokens and theme contract.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/index.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vanilla-extract/css": "^1.21.1",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "@vanilla-extract/vite-plugin": "^5.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
